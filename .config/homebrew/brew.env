# cf. https://docs.brew.sh/Manpage#environment

# If set, `brew bundle dump` will not dump VSCode (and forks/variants) extensions.
HOMEBREW_BUNDLE_DUMP_NO_VSCODE=true

# If set, run `brew bundle cleanup --force` after brew bundle install.
HOMEBREW_BUNDLE_FORCE_INSTALL_CLEANUP=true

# Cleanup all cached files older than this many days.
HOMEBREW_CLEANUP_MAX_AGE_DAYS=0

# If set, `brew install`, `brew upgrade` and `brew reinstall` will cleanup all formulae when this number of days has passed.
HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS=0

# If set, verbose output will print a `.` no more than once a minute.
HOMEBREW_VERBOSE_USING_DOTS=true
