# cf. `man git-config`

[core]
  ; For performance (`git status` etc)
  fsmonitor = true

[fetch]
  ; Prune the removed remote branches.
  prune = true

[pull]
  ; Prevent a merge commit
  ff = only

[push]
  ; `--set-upstream | -u` (e.g. `git push -u origin ...)
  autoSetupRemote = true

[rebase]
  ; Prevent commits from removed when `--interactive`.
  missingCommitsCheck = warn
  ; Update ref branches.
  updateRefs = true

[alias]
  discard-changes=restore --worktree
  unstage=restore --staged

  aa = add -A
  cp = cherry-pick
  l = log --stat
  poh = push origin HEAD
  rs = reset --soft
  rsh = reset --soft HEAD^
  rh = reset --hard
  rhh = reset --hard HEAD^

[user]
  ; Disable auto setting of the author.
  useConfigOnly = true
  ; name = zuka-e
  ; email = 52391918+zuka-e@users.noreply.github.com

[color "branch"]
  current = red bold
  local = green
  remote = yellow

[color "diff"]
  meta = cyan
  frag = magenta
  old = red
  new = green
