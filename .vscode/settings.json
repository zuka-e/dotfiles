{
  "files.associations": {
    "**/.config/*/config": "shellscript",
    "**/.config/*/ignore": "ignore",
    "**/.config/git/config": "ini",
    "{,.}{colorrc,inputrc,kitty.conf,tmux.conf}": "shellscript",
    "Brewfile.*": "ruby"
  },
  "shellcheck.exclude": [
    // cf. https://www.shellcheck.net/wiki
    "2148" // Shebang: useless for files referenced by `source`
  ],
  "shellcheck.ignorePatterns": {
    // Update default items
    "**/*.zsh": false,
    "**/*.zshrc": false,
    "**/*.zprofile": false,
    // Ignore
    "**/.config/**": true
  }
}
